#version 450
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(push_constant) uniform Constants {
    uint width;
    uint height;
    uint max_iterations;
} params;

layout(std430, binding = 0) writeonly buffer OutputBuffer {
    uint pixels[];
};

void main() {
    uint x = gl_GlobalInvocationID.x;
    uint y = gl_GlobalInvocationID.y;

    if (x >= params.width || y >= params.height) {
        return;
    }

    float x0 = (float(x) / float(params.width)) * 3.5 - 2.5;
    float y0 = (float(y) / float(params.height)) * 2.0 - 1.0;

    float xi = 0.0;
    float yi = 0.0;
    uint iter = 0;

    while (xi * xi + yi * yi <= 4.0 && iter < params.max_iterations) {
        float xtemp = xi * xi - yi * yi + x0;
        yi = 2.0 * xi * yi + y0;
        xi = xtemp;
        iter++;
    }

    uint color;
    if (iter == params.max_iterations) {
        color = 0xFF000000; // Black
    } else {
        float t = float(iter) / float(params.max_iterations);
        uint r = uint(9.0 * (1.0 - t) * t * t * t * 255.0);
        uint g = uint(15.0 * (1.0 - t) * (1.0 - t) * t * t * 255.0);
        uint b = uint(8.5 * (1.0 - t) * (1.0 - t) * (1.0 - t) * t * 255.0);
        color = (0xFF << 24) | (b << 16) | (g << 8) | r;
    }

    pixels[y * params.width + x] = color;
}
