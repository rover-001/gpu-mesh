[Version]
Signature="$Windows NT$"
Class=Display
ClassGuid={4d36e968-e325-11ce-bfc1-08002be10318}
Provider=%ManufacturerName%
CatalogFile=vkremote-iddcx.cat
DriverVer=10/31/2026,1.0.0.0
PnpLockdown=1

[Manufacturer]
%ManufacturerName%=Standard,NTamd64.10.0...16299

[Standard.NTamd64.10.0...16299]
%DeviceName%=vkremote_Device, Root\vkremote_IddCx

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
vkremote-iddcx.dll = 1

[DestinationDirs]
DefaultDestDir = 12
UMDriverCopy = 12\UMDF

[vkremote_Device.NT]
CopyFiles=UMDriverCopy

[UMDriverCopy]
vkremote-iddcx.dll

[vkremote_Device.NT.hw]
AddReg=vkremote_Device_Security_AddReg

[vkremote_Device_Security_AddReg]
HKR,,Security,,"D:P(A;;GA;;;BA)(A;;GA;;;SY)"

[vkremote_Device.NT.Services]
AddService=WUDFRd,0x000001fa,WUDFRD_ServiceInstall

[WUDFRD_ServiceInstall]
DisplayName = %WudfRdDisplayName%
ServiceType = 1
StartType = 3
ErrorControl = 1
ServiceBinary = %12%\WUDFRd.sys

[vkremote_Device.NT.Wdf]
UmdfService=vkremote-iddcx, vkremote_iddcx_Install
UmdfServiceOrder=vkremote-iddcx

[vkremote_iddcx_Install]
UmdfLibraryVersion=2.23.0
ServiceBinary=%12%\UMDF\vkremote-iddcx.dll
UmdfExtensions=IddCx0102

[Strings]
ManufacturerName="vkremote Project"
DiskName="vkremote Installation Disk"
DeviceName="vkremote Virtual GPU Adapter"
WudfRdDisplayName="Windows Driver Foundation - User-mode Driver Framework Reflector"
